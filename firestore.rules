rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDataAfter() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userData().role == 'admin';
    }

    function ownsRestaurant(restaurantId) {
      return signedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    function ownsAgency(agencyId) {
      return signedIn()
        && get(/databases/$(database)/documents/deliveryAgencies/$(agencyId)).data.ownerId == request.auth.uid;
    }

    function isAssignedCourier() {
      return signedIn() && resource.data.assignedCourierId == request.auth.uid;
    }

    function validSelfServiceRole(role) {
      return role in ['client', 'restaurant', 'courier'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && validSelfServiceRole(request.resource.data.role);
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && userDataAfter().role == 'restaurant';
      allow update: if isAdmin() || (ownsRestaurant(restaurantId)
        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || ownsRestaurant(restaurantId);
    }

    match /dishes/{dishId} {
      allow read: if true;
      allow create: if ownsRestaurant(request.resource.data.restaurantId);
      allow update: if isAdmin() || (ownsRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if ownsRestaurant(resource.data.restaurantId) || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && (request.resource.data.status == 'pending_payment'
          || (request.resource.data.status == 'paid'
            && request.resource.data.paymentMethod == 'cash'));
      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid
        || ownsRestaurant(resource.data.restaurantId)
        || resource.data.assignedCourierId == request.auth.uid
        || isAdmin()
      );
      allow update: if isAdmin() || (ownsRestaurant(resource.data.restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assignedCourierId', 'deliveryProvider', 'courierLocation', 'courierLocationUpdatedAt', 'externalCourierAcceptedAt', 'pickedUpAt', 'updatedAt']))
        || (isAssignedCourier()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'courierLocation', 'courierLocationUpdatedAt', 'externalCourierAcceptedAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /internalCouriers/{courierId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || ownsRestaurant(resource.data.restaurantId)
        || isAdmin()
      );
      allow create: if ownsRestaurant(request.resource.data.restaurantId);
      allow update: if isAdmin() || (ownsRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if ownsRestaurant(resource.data.restaurantId) || isAdmin();

      match /deliveryHistory/{entryId} {
        allow read, write: if isAdmin()
          || ownsRestaurant(get(/databases/$(database)/documents/internalCouriers/$(courierId)).data.restaurantId);
      }
    }

    match /independentCouriers/{courierId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();

      match /deliveryHistory/{entryId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/independentCouriers/$(courierId)).data.userId == request.auth.uid
          || isAdmin()
        );
        allow write: if isAdmin();
      }
    }

    match /deliveryAgencies/{agencyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && userData().role == 'agency';
      allow update: if isAdmin() || (ownsAgency(agencyId)
        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsAgency(agencyId) || isAdmin();

      match /deliveryHistory/{entryId} {
        allow read: if ownsAgency(agencyId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /publications/{publicationId} {
      allow read: if true;
      allow create: if ownsRestaurant(request.resource.data.restaurantId);
      allow update: if isAdmin() || (ownsRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if ownsRestaurant(resource.data.restaurantId) || isAdmin();

      match /likes/{userId} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin() || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'updatedAt']));
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );
      }
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && (
        isAdmin()
        || (resource.data.entityType == 'restaurant' && ownsRestaurant(resource.data.entityId))
        || (resource.data.entityType == 'delivery_agency' && ownsAgency(resource.data.entityId))
      );
      // Les écritures de paiement sont effectuées par un backend privilégié après validation FedaPay.
      allow write: if isAdmin();
    }
  }
}
