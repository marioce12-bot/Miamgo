rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isRestaurantOwner(restaurantId) {
      return signedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isPlatformAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.role in ['client', 'restaurant_owner', 'driver']
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'phone', 'country', 'city', 'role', 'createdAt', 'updatedAt']);
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'country', 'city', 'photoURL', 'addresses', 'payoutDetails', 'payoutStatus', 'pushToken', 'pushPlatform', 'availabilityStatus', 'updatedAt']);
    }

    match /restaurants/{restaurantId} {
      allow read: if resource.data.status == 'active' || resource.data.subscriptionStatus == 'active'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isPlatformAdmin()
        || (isRestaurantOwner(restaurantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'phone', 'address', 'city', 'country', 'description', 'coverURL', 'photoURL', 'openingHours', 'deliveryMode', 'updatedAt']));

      match /menuItems/{itemId} {
        allow read: if get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.status == 'active' || get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.subscriptionStatus == 'active' || isRestaurantOwner(restaurantId);
        allow write: if isRestaurantOwner(restaurantId) || isPlatformAdmin();
      }

      match /drivers/{driverId} {
        allow read: if isRestaurantOwner(restaurantId) || isSelf(driverId) || isPlatformAdmin();
        allow create, update: if isRestaurantOwner(restaurantId) || isPlatformAdmin();
        allow delete: if isRestaurantOwner(restaurantId) || isPlatformAdmin();
      }
    }

    match /stories/{storyId} {
      allow read: if resource.data.expiresAt > request.time && resource.data.status == 'active';
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'active' && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(1, 'd');
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /posts/{postId} {
      allow read: if !resource.data.keys().hasAny(['moderationStatus']) || resource.data.moderationStatus != 'removed';
      allow create: if signedIn() && isRestaurantOwner(request.resource.data.restaurantId);
      allow update, delete: if signedIn() && isRestaurantOwner(resource.data.restaurantId);

      match /likes/{userId} {
        allow read: if true;
        allow create: if isSelf(userId) && request.resource.data.userId == userId;
        allow update, delete: if isSelf(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
        match /replies/{replyId} {
          allow read: if true;
          allow create: if signedIn()
            && isRestaurantOwner(get(/databases/$(database)/documents/posts/$(postId)).data.restaurantId)
            && request.resource.data.userId == request.auth.uid;
          allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
        }
      }
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /carts/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.status == 'active';
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || isRestaurantOwner(resource.data.restaurantId)
          || resource.data.assignedDriverId == request.auth.uid
          || isPlatformAdmin());
      allow update: if signedIn()
        && (isRestaurantOwner(resource.data.restaurantId) || isPlatformAdmin());
      allow update: if signedIn()
        && resource.data.assignedDriverId == request.auth.uid
        && request.resource.data.assignedDriverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assignedDriverId', 'deliveryStatus', 'trackingActive', 'startedAt', 'updatedAt',
          'status'
        ]);
    }

    match /paymentEvents/{eventId} {
      allow read, write: if isPlatformAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }

    match /driverApplications/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'firstName', 'lastName', 'phone', 'city', 'country',
          'gender', 'identityDocumentUrl', 'restaurantInvitation',
          'status', 'createdAt', 'updatedAt'
        ]);
      allow read: if isSelf(userId) || isPlatformAdmin();
      allow update: if isPlatformAdmin()
        || (isSelf(userId)
          && request.resource.data.userId == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'lastName', 'phone', 'city', 'country', 'gender',
            'identityDocumentUrl', 'restaurantInvitation', 'updatedAt'
          ]));
    }

    match /driverLocations/{driverId} {
      allow read: if isSelf(driverId) || isPlatformAdmin();
      allow create: if isSelf(driverId)
        && request.resource.data.keys().hasOnly([
          'latitude', 'longitude', 'accuracy', 'tracking', 'updatedAt'
        ]);
      allow update: if isSelf(driverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'latitude', 'longitude', 'accuracy', 'tracking', 'updatedAt'
        ]);
    }

    match /phoneIndex/{phoneKey} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.phone == phoneKey;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.phone == phoneKey;
      allow delete: if isPlatformAdmin();
    }

    match /driverRestaurants/{affiliationId} {
      allow create: if signedIn() && request.resource.data.driverId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.driverId == request.auth.uid
          || isRestaurantOwner(resource.data.restaurantId)
          || isPlatformAdmin());
      allow update: if signedIn()
        && (resource.data.driverId == request.auth.uid
          || isRestaurantOwner(resource.data.restaurantId)
          || isPlatformAdmin());
      allow delete: if signedIn()
        && (resource.data.driverId == request.auth.uid
          || isRestaurantOwner(resource.data.restaurantId)
          || isPlatformAdmin());
    }

    match /driverDirectory/{driverId} {
      allow read: if isPlatformAdmin()
        || (signedIn()
          && resource.data.verificationStatus == 'approved'
          && resource.data.subscriptionStatus == 'active');
      allow create: if isSelf(driverId)
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.subscriptionStatus in ['locked', 'pending_payment'];
      allow update: if isSelf(driverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'city', 'country',
          'availabilityStatus', 'updatedAt'
        ])
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus;
    }
  }
}
