rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isRestaurantOwner(restaurantId) {
      return signedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isPlatformAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.role == 'client'
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt', 'updatedAt']);
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL', 'addresses', 'updatedAt']);
    }

    match /restaurants/{restaurantId} {
      allow read: if resource.data.status == 'active' || isRestaurantOwner(restaurantId) || isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isRestaurantOwner(restaurantId) || isPlatformAdmin();

      match /menuItems/{itemId} {
        allow read: if get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.status == 'active' || isRestaurantOwner(restaurantId);
        allow write: if isRestaurantOwner(restaurantId) || isPlatformAdmin();
      }

      match /drivers/{driverId} {
        allow read: if isRestaurantOwner(restaurantId) || isSelf(driverId) || isPlatformAdmin();
        allow create, update: if isRestaurantOwner(restaurantId) || isPlatformAdmin();
        allow delete: if isRestaurantOwner(restaurantId) || isPlatformAdmin();
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && isRestaurantOwner(request.resource.data.restaurantId);
      allow update, delete: if signedIn() && isRestaurantOwner(resource.data.restaurantId);

      match /likes/{userId} {
        allow read: if true;
        allow create: if isSelf(userId) && request.resource.data.userId == userId;
        allow update, delete: if isSelf(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /carts/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || isRestaurantOwner(resource.data.restaurantId)
          || isPlatformAdmin());
      allow update: if signedIn()
        && (isRestaurantOwner(resource.data.restaurantId) || isPlatformAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }

    match /driverApplications/{userId} {
      allow create: if isSelf(userId) && request.resource.data.userId == userId;
      allow read: if isSelf(userId) || isPlatformAdmin();
      allow update: if isPlatformAdmin();
    }
  }
}
